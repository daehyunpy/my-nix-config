{
    "soft_wrap": "none",
    "disable_ai": false,
    "cli_default_open_behavior": "existing_window",
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "project_panel": {
        "dock": "left"
    },
    "agent_servers": {
        "OMP": {
            "type": "custom",
            "command": "omp",
            "args": ["acp", "--mcp"],
            "env": {}
        },
        "cursor": {
            "type": "registry"
        },
        "pi-acp": {
            "favorite_config_option_values": {
                "model": [
                    "openai-codex/gpt-6-astra",
                    "openai-codex/gpt-6.1-sol",
                    "openai-codex/gpt-5.6-terra",
                    "openai-codex/gpt-6-luna"
                ]
            },
            "default_config_options": {
                "model": "openai-codex/gpt-6.1-sol",
                "thought_level": "high"
            },
            "type": "registry"
        },
        "opencode": {
            "favorite_config_option_values": {
                "model": [
                    "openai/gpt-6-astra",
                    "openai/gpt-6.1-sol",
                    "openai/gpt-5.6-terra",
                    "openai/gpt-6-luna"
                ]
            },
            "default_config_options": {
                "mode": "build",
                "effort": "high",
                "model": "openai/gpt-6.1-sol"
            },
            "type": "registry"
        },
        "gemini": {
            "type": "registry"
        },
        "github-copilot-cli": {
            "type": "registry"
        },
        "codex-acp": {
            "type": "registry"
        },
        "claude-acp": {
            "default_config_options": {
                "mode": "auto",
                "fast": "off",
                "model": "sonnet"
            },
            "type": "registry"
        }
    },
    "agent": {
        "dock": "right",
        "threads_sidebar": {
            "position": "right"
        },
        "favorite_models": [
            {
                "provider": "openai",
                "model": "gpt-6.1-sol",
                "enable_thinking": true,
                "effort": "high"
            }
        ],
        "default_model": {
            "effort": "high",
            "enable_thinking": true,
            "model": "gpt-6.1-sol",
            "provider": "openai"
        }
    },
    "autosave": "on_focus_change",
    "edit_predictions": {
        "provider": "none"
    },
    "format_on_save": "off",
    "git_panel": {
        "dock": "left",
        "tree_view": true
    },
    "helix_mode": true,
    "inlay_hints": {
        "enabled": true
    },
    "languages": {
        "Python": {
            "code_actions_on_format": {
                "source.organizeImports.ruff": true
            }
        },
        "SQL": {
            "tab_size": 2
        },
        "JSON": {
            "tab_size": 2
        },
        "YAML": {
            "tab_size": 2
        },
        "Markdown": {
            "tab_size": 2
        }
    },
    "relative_line_numbers": "enabled",
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "theme": {
        "dark": "One Dark",
        "light": "One Light",
        "mode": "system"
    },
    "wrap_guides": [72, 79],
    "ui_font_size": 12,
    "buffer_font_size": 10,
    "agent_ui_font_size": 12,
    "agent_buffer_font_size": 10,
    "buffer_font_features": {
        "liga": true
    }
}
